# 개인 설정은 .env.local 에 복사해서 사용한다. (.env.local 은 Git 제외)
# 브라우저에 공개되는 값이므로 비밀 키를 넣지 않는다.
VITE_API_BASE_URL=http://localhost:8080/api

# 실제 로그인 전 개발 서버(npm run dev)에서만 쓰는 테스트 사용자 기본값. 화면 왼쪽 아래 테스트 계정 스위치로 바꿀 수 있다.
# 고객 CUSTOMER_1·CUSTOMER_2, 사장님 OWNER_1(매장 1)·OWNER_2(매장 2), 관리자 ADMIN
VITE_TEST_USER=

# 카카오맵 JavaScript 키 (Kakao Developers > 앱 > 플랫폼 키 > JavaScript 키)
# JavaScript SDK 도메인에 http://localhost:5173 을 등록하고 제품 설정 > 카카오맵을 켜야 지도가 뜬다.
# 실제 키는 .env.local 에만 넣는다.
VITE_KAKAO_MAP_APP_KEY=

# 포트원(아임포트 V1) 가맹점 식별코드 (포트원 관리자 콘솔 > 내 식별코드). 결제창을 여는 공개용 값이다.
# API 시크릿(imp_secret)은 서버 설정에만 두고 여기에는 절대 넣지 않는다.
VITE_PORTONE_IMP_CODE=
