# 기존 Oracle의 관리자 비밀번호
ORACLE_PASSWORD=CHANGE_ME

# 기존 Oracle 앱 계정과 현재 비밀번호
APP_USER=SCOTT
APP_USER_PASSWORD=CHANGE_ME

CORS_ALLOWED_ORIGINS=https://dev.thankunnie.shop

# 로그인 토큰 서명 키. 32바이트 이상 임의 문자열을 서버에서 직접 생성해 입력 (예: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME
SWAGGER_ENABLED=false

# 매장·시술 대표 이미지 S3 저장소. AWS 자격 증명은 EC2 IAM 역할로 받으므로 키를 넣지 않는다
SHOP_IMAGE_STORAGE=s3
SHOP_IMAGE_S3_BUCKET=
SHOP_IMAGE_S3_PREFIX=shop-images/
AWS_REGION=ap-northeast-2

# 알림 문자 발송 (Solapi 콘솔 값). 비워 두면 문자를 보내지 않는다
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 콘솔에 등록한 발신번호. 숫자만 (예: 01012345678)
SOLAPI_FROM_NUMBER=

# 서버에서 직접 프론트 이미지를 빌드할 때만 쓰는 카카오맵 JavaScript 키 (CD 는 GitHub Actions 변수 사용)
VITE_KAKAO_MAP_APP_KEY=

# 로컬 이미지 이름. CD 구성 시 GHCR 이미지:커밋SHA로 변경
BACKEND_IMAGE=unnie-backend:local
FRONTEND_IMAGE=unnie-frontend:local

# 결제 연동 시 입력
IAMPORT_IMP_KEY=
IAMPORT_IMP_SECRET=
# 개발 서버는 포트원 테스트 채널을 쓰므로 true. 실결제 운영 서버는 false
IAMPORT_INCLUDE_SANDBOX=false
