# 복사해서 application-local.yml 로 사용 (Git 제외 파일)
# 로컬 개발: H2 (Oracle 호환 모드)
spring:
  datasource:
    # DB_CLOSE_DELAY=-1 을 붙이면 devtools 재시작 때 기존 테이블이 남아 스키마 생성이 실패한다
    url: jdbc:h2:mem:thankunnie;MODE=Oracle;DEFAULT_NULL_ORDERING=HIGH
    username: sa
    password:
    driver-class-name: org.h2.Driver
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
  h2:
    console:
      enabled: true

app:
  cors:
    allowed-origins: http://localhost:5173
  scheduling:
    # 임박 알림 감지 등 주기 작업. 생략하면 true
    enabled: true

# Oracle 전용 기능 확인이 필요하면 루트에서 docker compose up -d 후 위 datasource 를 아래로 교체
#  datasource:
#    url: jdbc:oracle:thin:@localhost:1521/FREEPDB1
#    username: SCOTT
#    password: TIGER
#    driver-class-name: oracle.jdbc.OracleDriver


iamport:
  imp-key: CHANGE_ME
  imp-secret: CHANGE_ME
  # 테스트 채널 결제 조회용. 로컬에서만 true
  include-sandbox: true
